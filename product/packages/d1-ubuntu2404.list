# Packages for TuwaiqOS Product D1 (Ubuntu 24.04)
# Extends D0 set. Identity + connectivity foundation.
# One package per line. Comments allowed.

# Kernel (virtual guest profile — swap to linux-image-generic for bare metal)
linux-image-virtual

# HARDWARE (optional for bare-metal images; omit for QEMU foundation):
# linux-image-generic
# linux-firmware
# intel-microcode
# amd64-microcode
# wpasupplicant
# wireless-regdb
# iw

# Display manager + Plasma (X11 D0 path preserved; Wayland remains installed for later)
sddm
sddm-theme-breeze
plasma-desktop
plasma-workspace
plasma-workspace-wayland
plasma-wayland-protocols
kwin-x11
kwin-wayland
systemsettings
plasma-nm
plasma-pa
dolphin
konsole
kate
breeze
breeze-icon-theme
fonts-noto
fonts-noto-core
fonts-noto-ui-core
fonts-noto-color-emoji

# X11 runtime required for QEMU graphical acceptance
xserver-xorg
xserver-xorg-core
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xinit
x11-xserver-utils

# Base desktop utilities + connectivity
network-manager
ufw
curl
iputils-ping
dnsutils
iproute2
pipewire
wireplumber
mesa-vulkan-drivers
xdg-desktop-portal-kde
dbus-x11
sudo
locales
locales-all

# Arabic + English locale support (RTL-ready packaging)
language-pack-en
language-pack-ar
language-pack-kde-en
language-pack-kde-ar

initramfs-tools
