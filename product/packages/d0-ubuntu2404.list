# Packages for TuwaiqOS Product D0 (Ubuntu 24.04)
# One package per line. Comments allowed.
# D0 targets a bootable QEMU/desktop foundation image. Full OEM firmware
# packs are optional (see HARDWARE note below) to keep the first image build
# reproducible on constrained networks.

# Kernel (virtual guest profile — swap to linux-image-generic for bare metal)
linux-image-virtual

# HARDWARE (optional for bare-metal D0 images; omit for QEMU foundation):
# linux-image-generic
# linux-firmware
# intel-microcode
# amd64-microcode

# Display manager + Plasma (Wayland)
sddm
sddm-theme-breeze
plasma-desktop
plasma-workspace-wayland
plasma-wayland-protocols
kwin-wayland
systemsettings
plasma-nm
plasma-pa
dolphin
konsole
kate
breeze
breeze-icon-theme
fonts-noto
fonts-noto-core
fonts-noto-ui-core
fonts-noto-color-emoji

# Base desktop utilities
network-manager
pipewire
wireplumber
mesa-vulkan-drivers
xdg-desktop-portal-kde
dbus-x11
sudo
locales
locales-all

# Arabic + English locale support
language-pack-en
language-pack-ar
language-pack-kde-en
language-pack-kde-ar

initramfs-tools
