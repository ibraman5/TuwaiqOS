[Unit]
Description=Tuwaiq D1 acceptance evidence collector
After=NetworkManager-wait-online.service network-online.target
Wants=NetworkManager-wait-online.service
ConditionPathExists=!/var/lib/tuwaiq/connectivity/d1-acceptance.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/tuwaiq/d1-acceptance-collect.sh
ExecStartPost=/bin/touch /var/lib/tuwaiq/connectivity/d1-acceptance.done
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
